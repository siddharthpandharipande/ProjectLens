# Environment
ENVIRONMENT=development
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8001

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Database connection
# Default: PostgreSQL connection string
# Format: postgresql+psycopg://username:password@localhost:5432/database_name
# Note: For SQLite fallback during local testing: sqlite:///./projectlens.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/projectlens

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# LLM Configuration
# Set LLM_PROVIDER to "gemini" (recommended) or "openrouter"
LLM_ENABLED=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# Google Gemini API Configuration (Powers Phase 8 Viva Generator, Phase 9 AI Assistance & Innovation Analyzer)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Configuration (Optional fallback provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Semantic Similarity
SIMILARITY_ENABLE_SEMANTIC=true
